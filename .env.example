# Add local development variables here as the app grows.
# Do not put real secrets in this file.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Only the exact value true enables paid AI requests; any other value pauses them.
AI_REQUESTS_ENABLED=true
# Required for shared Vercel/multi-instance rate limiting. Leave empty only for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
